# This is a self-contained portfolio demo — no environment variables are
# required to build or run it. All data lives in src/data/*.json and is
# served from an in-memory store (see src/lib/demo-store.ts).
#
# DATABASE_URL below is only relevant if you want to restore the original
# Prisma/Postgres-backed version of this app (schema/migrations/seed kept in
# prisma/ for reference) — it is not read by the app as shipped.
# DATABASE_URL="postgresql://postgres:password@localhost:5432/light_textiles?schema=public"
