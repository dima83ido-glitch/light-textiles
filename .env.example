# Postgres connection string (Prisma). Required.
DATABASE_URL="postgresql://postgres:password@localhost:5432/light_textiles?schema=public"

# Signing secret for the admin session cookie. Required — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Required to run `npm run db:seed` — sets the initial OWNER account.
# The seed script fails with an error if either is missing; there is no default/fallback.
OWNER_EMAIL=""
OWNER_PASSWORD=""
