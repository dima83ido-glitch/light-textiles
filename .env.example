# Postgres connection string (Prisma). Required.
DATABASE_URL="postgresql://postgres:password@localhost:5432/light_textiles?schema=public"

# Signing secret for the admin session cookie. Required — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional — used only by `npm run db:seed` to set the initial OWNER account.
# If unset, the seed script falls back to a hardcoded dev default (see prisma/seed.ts).
OWNER_EMAIL=""
OWNER_PASSWORD=""
